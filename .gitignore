# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
# pytest caches
.pytest_cache/
.mypy_cache/
*.db
*.sqlite3

# ── Node / frontend ──────────────────────────────────────
node_modules/
npm-debug.log*
services/frontend/dist/
.vite/
*.tsbuildinfo

# ── Secrets / env ────────────────────────────────────────
.env
.env.*
*.env
!.env.example

# ── PX4 firmware (cloned/compiled at runtime, do not commit) ─
PX4-Autopilot/
services/drone/PX4-Autopilot/

# ── Packet captures (SIEM/sniffer artifacts) ─────────────
*.pcap
*.pcap[0-9]*
*.pcapng
eve.json
# Reference captures used to validate IDS rules ARE committed.
!services/sensor/tests/fixtures/*.pcap

# ── Sensor runtime artifacts ─────────────────────────────
# Rotating packet captures written by the sensor (bounded by
# suricata.yaml pcap-log limit/max-files). Never committed.
captures/
services/sensor/logs/

# ── Editor / OS ──────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Local agent config (never commit) ────────────────────
.claude/
**/.claude/
CLAUDE.md
CLAUDE.local.md
# Playwright MCP scratch, when a sync drops it on a remote host.
.playwright-mcp/
# Screenshots from browser-driven verification runs.
/*.png

# ── Ansible deploy artifacts ─────────────────────────────
# build-archive.sh tars this very repo, so committing the result would store a
# ~20 MB copy of the tree inside the tree, stale from the next edit onwards.
ansible/roles/drone_lab/files/*.tar.gz

# The inventory carries the range's SSH and sudo passwords. The committed
# template is inventory.yml.example; your real inventory stays local.
ansible/inventory.yml

# Design notes written by tooling, kept locally and not shipped.
docs/superpowers/