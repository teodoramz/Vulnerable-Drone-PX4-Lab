# Copy to .env and adjust. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────
POSTGRES_USER=fleet
POSTGRES_PASSWORD=Admin1Admin1
POSTGRES_DB=fleet

# ─────────────────────────────────────────────────────────
# Auth / JWT  (CHANGE JWT_SECRET to a long random string!)
# ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─────────────────────────────────────────────────────────
# Seed accounts
# ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1Admin1
# Also create the "operator" and "observer" accounts
# All three accounts are re-asserted on every boot; the login page deliberately does not print them.
#   admin     full control, can force-release another operator's claim
#   operator  can claim and fly the drone
#   observer  can watch everything -- including the live mission and the
#             Inventory tab -- and command nothing
SEED_DEMO_USERS=true
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=Admin1Admin1
OBSERVER_USERNAME=observer
OBSERVER_PASSWORD=Admin1Admin1

# ─────────────────────────────────────────────────────────
# px4 = real PX4 SITL (first build ~20-40 min, cached in a volume); mock = lightweight, via:
#   docker compose -f docker-compose.yml -f docker-compose.mock.yml up --build
# ─────────────────────────────────────────────────────────
DRONE_BACKEND=px4
DRONE_API_URL=http://drone:9100
DRONE_WS_URL=ws://drone:9100/ws
DRONE_MAVLINK_PORT=14540
DRONE_HOST=drone
DRONE_COUNT=1

# ─────────────────────────────────────────────────────────
# Home position - launch pad HP-1, east apron, Marwick International Airport.
# Seeds the drone service's registry; the C2 relocates home from the site dataset.
# ─────────────────────────────────────────────────────────
HOME_LAT=43.9977991
HOME_LON=25.0154851
HOME_ALT=95.0

# ─────────────────────────────────────────────────────────
# Sensor / IDS
# The push token authenticates the sensor to c2 (POST /api/ids/alerts) over the gcs boundary port,
# so a compromised c2 can suppress alerts (by design). The sensor :9200 API is the out-of-band source of truth.
# ─────────────────────────────────────────────────────────
SENSOR_IFACES=ot-ops,ot-air
EVE_PATH=/var/log/suricata/eve.json
# Not http://c2:8000: the sensor uses network_mode: host, outside Docker DNS. Use the c2 published port,
# or the C2 address on the ops segment on a dedicated sensor VM.
C2_URL=http://127.0.0.1:8000
IDS_PUSH_TOKEN=ids-dev-token
IDS_BUFFER_SIZE=500
# Flow records for the Traffic view; c2 reaches the host-networked sensor via the ops gateway.
SENSOR_URL=http://172.30.10.1:9200

# ─────────────────────────────────────────────────────────
# Ground station (gcs) nginx proxy target
# ─────────────────────────────────────────────────────────
C2_UPSTREAM=http://c2:8000

# Host port for the web console (nginx listens on 80 in-container); 8080 for dev.
GCS_HOST_PORT=8080

# Host port for the C2 REST/WebSocket API (affects outside access only).
C2_HOST_PORT=8000

# ─────────────────────────────────────────────────────────
# CORS - origins allowed to call the C2 API directly (dev)
# ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
