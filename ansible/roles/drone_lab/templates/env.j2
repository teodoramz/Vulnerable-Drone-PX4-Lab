# Managed by Ansible (ansible/roles/drone_lab). Local edits will be overwritten.

DRONE_BACKEND={{ drone_lab_backend }}
DRONE_COUNT={{ drone_lab_drone_count }}
HOME_ALT={{ drone_lab_home_alt }}

# --- C2 auth ---
JWT_SECRET={{ drone_lab_jwt_secret }}
ADMIN_USERNAME={{ drone_lab_admin_user }}
ADMIN_PASSWORD={{ drone_lab_admin_pass }}
SEED_DEMO_USERS={{ drone_lab_seed_demo_users | lower }}
OPERATOR_USERNAME={{ drone_lab_operator_user }}
OPERATOR_PASSWORD={{ drone_lab_operator_pass }}
OBSERVER_USERNAME={{ drone_lab_observer_user }}
OBSERVER_PASSWORD={{ drone_lab_observer_pass }}

# --- Database ---
POSTGRES_DB={{ drone_lab_postgres_db }}
POSTGRES_USER={{ drone_lab_postgres_user }}
POSTGRES_PASSWORD={{ drone_lab_postgres_pass }}

# --- Console ---
GCS_HOST_PORT={{ drone_lab_console_port | default(80) }}
C2_HOST_PORT={{ drone_lab_api_port | default(8000) }}
CORS_ORIGINS=http://{{ ansible_host | default('localhost') }}

# --- Sensor ---
SENSOR_IFACES={{ drone_lab_sensor_ifaces }}
IDS_PUSH_TOKEN={{ drone_lab_ids_push_token }}
