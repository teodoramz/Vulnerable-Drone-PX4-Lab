# Split-deployment configuration: copy to .env on every host and set real addresses/secrets. NEVER commit the real .env.

# ─────────────────────────────────────────────────────────
# Component addresses (LAN IP or resolvable hostname).
# Every cross-host address is env-driven.
# ─────────────────────────────────────────────────────────
DB_HOST=10.0.0.10
DRONE_HOST=10.0.0.20
C2_HOST=10.0.0.30
# gcs is the one component allowed outside the internal network; CORS_ORIGINS must list its address.
CORS_ORIGINS=http://10.0.0.40:8080

# ─────────────────────────────────────────────────────────
# Drone backend: px4 (default, real MAVLink firmware) | mock
# For mock, use the root docker-compose.mock.yml stack instead.
# ─────────────────────────────────────────────────────────
DRONE_BACKEND=px4
DRONE_COUNT=1
INSTALL_PX4=true

# Home position - launch pad HP-1, east apron, Marwick International Airport.
# Seeds the drone service's registry; the C2 relocates home from the site dataset.
HOME_LAT=43.9977991
HOME_LON=25.0154851
HOME_ALT=95.0

# ─────────────────────────────────────────────────────────
# Database (identical on the db and c2 hosts).
# ─────────────────────────────────────────────────────────
POSTGRES_USER=fleet
POSTGRES_PASSWORD=Admin1Admin1
POSTGRES_DB=fleet

# ─────────────────────────────────────────────────────────
# C2 auth.
# ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1Admin1
SEED_DEMO_USERS=false

# ─────────────────────────────────────────────────────────
# The token authenticates the sensor push to c2 over the gcs boundary port (c2:8000),
# so a compromised c2 can suppress alerts (by design). The sensor :9200 API is not gated by it.
# ─────────────────────────────────────────────────────────
# Capture interfaces. ot-ops,ot-air exist only on the single-host stack; on a sensor VM use the mirror NIC (e.g. eth1).
SENSOR_IFACES=eth0
EVE_PATH=/var/log/suricata/eve.json
IDS_PUSH_TOKEN=change-me-shared-sensor-c2-token
IDS_BUFFER_SIZE=500
# Where c2 pulls flow records from for the console's Traffic view.
SENSOR_URL=http://10.0.0.50:9200
